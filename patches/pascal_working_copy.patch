+
+procedure CalcSRDiagTrace(X, Y: Integer; const S: String);
+var
+  FS: TFileStream;
+  Line: AnsiString;
+begin
+  if not HeadlessDiagPixelEnabled then Exit;
+  if (X <> HeadlessDiagPixelX) or (Y <> HeadlessDiagPixelY) then Exit;
+  if HeadlessDiagTracePath = '' then Exit;
+  try
+    if FileExists(HeadlessDiagTracePath) then
+      FS := TFileStream.Create(HeadlessDiagTracePath, fmOpenReadWrite or fmShareDenyNone)
+    else
+      FS := TFileStream.Create(HeadlessDiagTracePath, fmCreate or fmShareDenyNone);
+    try
+      FS.Seek(0, soEnd);
+      Line := AnsiString(Format('x=%d y=%d %s', [X, Y, S]) + #13#10);
+      if Length(Line) > 0 then
+        FS.WriteBuffer(Line[1], Length(Line));
+    finally
+      FS.Free;
+    end;
+  finally
+  end;
+end;
+
+procedure CalcSRDiagStderr(const S: String);
+begin
+  if not HeadlessDiagPixelActive then Exit;
+  WriteLn(ErrOutput, S);
+  Flush(ErrOutput);
+end;
 
