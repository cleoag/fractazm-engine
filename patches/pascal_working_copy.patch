@@ -89,6 +89,41 @@
 
 uses Mand, Math, Dialogs, Windows, Math3D, formulas, FormulaGUI, HeaderTrafos, FormulaCompiler,
   Classes, CompilerUtil;
+
+{ --- portable_math.dll SSE2 formula override ----------------------------
+  .m3f files ship their [CODE] section as pre-compiled i386 x87 machine
+  code.  Run on Windows x64 that x87 bytecode rounds intermediate results
+  in 80-bit extended precision and produces values that drift from the
+  C++ port's SSE2 execution path by 1+ ULP per operation, which
+  compounds across ray-march iterations into visible image differences.
+
+  portable_math.dll (built by external_formulas/vendored/portable_math)
+  exports SSE2 re-implementations of select formulas under the name
+  "mb3d_formula_<CustomFname>_Pascal".  Each exported function uses the
+  Pascal i386 register calling convention (EAX/EDX/ECX + stack, ret 8),
+  matching ThybridIteration exactly, so Pascal can plug the DLL address
+  directly into pCodePointer with no shim.
+
+  Substitution is opt-in: a formula only gets overridden when the DLL
+  happens to export a matching symbol.  Unknown formulas continue to run
+  the original [CODE] bytecode. }
+var
+  PortableMathDllHandle: HMODULE = 0;
+  PortableMathDllTried: Boolean = False;
+
+function TryGetPortableMathProc(const CustomFname: array of Byte): Pointer;
+var
+  s: AnsiString;
+begin
+  Result := nil;
+  if not PortableMathDllTried then begin
+    PortableMathDllTried := True;
+    PortableMathDllHandle := LoadLibraryA('portable_math.dll');
+  end;
+  if PortableMathDllHandle = 0 then Exit;
+  s := 'mb3d_formula_' + CustomFtoStr(CustomFname) + '_Pascal';
+  Result := GetProcAddress(PortableMathDllHandle, PAnsiChar(s));
+end;
 
 procedure CheckHybridOptions(pHCA: PTHeaderCustomAddon);
 var x, end1, repeat1, start2, end2, repeat2: Integer;
@@ -1028,6 +1063,26 @@
