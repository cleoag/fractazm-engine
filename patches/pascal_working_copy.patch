+procedure HeadlessWriteSiLightDump(Width, Height: Integer; PSL: TPsiLight5; Count: Integer);
+type
+  TSiLightDumpHeader = packed record
+    Magic: array[0..7] of AnsiChar;
+    Version: LongWord;
+    Width: LongWord;
+    Height: LongWord;
+    RecordSize: LongWord;
+    Count: LongWord;
+  end;
+var
+  Header: TSiLightDumpHeader;
+  FS: TFileStream;
+  OutDir: String;
+  Src: TPsiLight5;
+begin
+  if HeadlessSiLightDumpPath = '' then Exit;
+  if (PSL = nil) or (Count < 0) then
+    HeadlessFail('invalid siLight5 dump source');
+
+  OutDir := ExtractFilePath(ExpandFileName(HeadlessSiLightDumpPath));
+  if (OutDir <> '') and not DirectoryExists(OutDir) then
+    if not ForceDirectories(OutDir) then
+      HeadlessFail('failed to create siLight5 dump directory: ' + OutDir);
+
+  FillChar(Header, SizeOf(Header), 0);
+  Header.Magic[0] := 'S';
+  Header.Magic[1] := 'I';
+  Header.Magic[2] := 'L';
+  Header.Magic[3] := '5';
+  Header.Magic[4] := 'D';
+  Header.Magic[5] := 'M';
+  Header.Magic[6] := 'P';
+  Header.Magic[7] := '1';
+  Header.Version := 1;
+  Header.Width := LongWord(Width);
+  Header.Height := LongWord(Height);
+  Header.RecordSize := LongWord(SizeOf(TsiLight5));
+  Header.Count := LongWord(Count);
+
+  try
+    FS := TFileStream.Create(HeadlessSiLightDumpPath, fmCreate);
+    try
+      FS.WriteBuffer(Header, SizeOf(Header));
+      Src := PSL;
+      if (not HeadlessSiLightDumpLive) and
+         (Length(gHeadlessSiLightCaptured) = Count) and
+         (gHeadlessSiLightWidth = Width) and
+         (gHeadlessSiLightHeight = Height) and
+         (Count > 0) then
+        Src := @gHeadlessSiLightCaptured[0];
+      if Count > 0 then
+        FS.WriteBuffer(Src^, Count * SizeOf(TsiLight5));
+    finally
+      FS.Free;
+    end;
+  except
+    on E: Exception do
+      HeadlessFail('failed to write siLight5 dump "' + HeadlessSiLightDumpPath + '": ' + E.Message);
+  end;
+end;
+
+initialization
+  gDiagWriteLock := TCriticalSection.Create;
+finalization
+  gDiagWriteLock.Free;
+
 end.
