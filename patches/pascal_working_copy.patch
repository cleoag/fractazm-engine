+unit RaySetupDump;
+
+{$mode delphi}
+{$asmmode intel}
+
+interface
+
+uses
+  SysUtils, Classes, Math, TypeDefinitions, Math3D, HeadlessRender;
+
+type
+  TRaySetupDumpRecord = packed record
+    x: LongInt;
+    y: LongInt;
+    thread_id: LongInt;
+    seed_before_first_step: LongInt;
+    camera_optic: LongInt;
+    cut_options: LongInt;
+    bin_steps: LongInt;
+    ray_ready_captured: LongInt;
+    calcde_enter_captured: LongInt;
+    calcde_retry_index: LongInt;
+    inside_rendering: LongInt;
+    calc_inside: LongInt;
+    in_and_out: LongInt;
+    calcde_inside_rendering: LongInt;
+    calcde_calc_inside: LongInt;
+    calc_sit: LongInt;
+    it_result: LongInt;
+    max_it: LongInt;
+    cut_plane_hit: LongInt;
+    vary_destop: LongInt;
+    cafx: Double;
+    cafy: Double;
+    fovx_off: Double;
+    fovx_mul: Double;
+    fovy: Double;
+    step_width: Double;
+    de_stop: Double;
+    ray_ms_destop: Double;
+    ms_destop: Double;
+    ray_mzz: Double;
+    mzz: Double;
+    zend: Double;
+    start_destop: Double;
+    max_ray_length: Double;
+    zzpos_mul: Double;
+    de_mul_vary: Double;
+    de_mul_const: Double;
+    smooth_it: Double;
+    rout: Double;
+    otrap: Double;
+    r_stop: Double;
+    ddescale: Double;
+    mct_de_offset: Double;
+    mct_de_offset006: Double;
+    mvgrads_fov: array[0..2] of Double;
+    view_vec: array[0..2] of Double;
+    march_vec: array[0..2] of Double;
+    ray_ready_start: array[0..2] of Double;
+    calcde_enter_pos: array[0..2] of Double;
+    act_pos: array[0..2] of Double;
+    ystart: array[0..2] of Double;
+    vgrads0: array[0..2] of Double;
+    vgrads1: array[0..2] of Double;
+  end;
+  PRaySetupDumpRecord = ^TRaySetupDumpRecord;
+
+procedure RaySetupConfigure(const DumpPath: String; Deterministic: Boolean);
+procedure RaySetupBeginFrame(Width, Height: Integer);
+procedure RaySetupFinishFrame;
+procedure RaySetupCaptureRayReady(MCTparas: PMCTparameter; SeedBefore: Integer; x, y: Integer);
+procedure RaySetupCaptureFirstCalcDEEnter(MCTparas: PMCTparameter; x, y, CutPlaneIndex: Integer; AfterCutPlane: Boolean);
+procedure RaySetupMarkNoFirstCalcDE(x, y, CutPlaneIndex: Integer);
+function RaySetupOnly: Boolean;
+function RaySetupDeterministic: Boolean;
+function RaySetupDeterministicThreadSeed(ThreadId: Integer): Integer;
+
+implementation
+
+type
+  TRaySetupDumpHeader = packed record
+    Magic: array[0..7] of AnsiChar;
+    Version: LongWord;
+    Width: LongWord;
+    Height: LongWord;
+    RecordSize: LongWord;
+    Count: LongWord;
+  end;
+
+var
+  gRaySetupDumpPath: String = '';
+  gRaySetupDeterministic: Boolean = False;
+  gRaySetupWidth: Integer = 0;
+  gRaySetupHeight: Integer = 0;
+  gRaySetupRecords: array of TRaySetupDumpRecord;
+
+function ReadTraceMXCSR: LongWord;
+var csr: LongWord;
+begin
+  asm stmxcsr csr end;
+  Result := csr;
+end;
+
+function PascalBool(Value: LongBool): LongInt;
+begin
+  if Value then Result := -1 else Result := 0;
+end;
+
+function PascalByteBool(Value: ByteBool): LongInt;
+begin
+  if Value then Result := -1 else Result := 0;
+end;
+
+procedure CopyVec3(var Dst: array of Double; const Src: TVec3D);
+begin
+  Dst[0] := Src[0];
+  Dst[1] := Src[1];
+  Dst[2] := Src[2];
+end;
+
+procedure EnsureRecordSize;
+begin
+  if SizeOf(TRaySetupDumpRecord) <> 488 then
+    raise Exception.CreateFmt('TRaySetupDumpRecord size mismatch: %d <> 488', [SizeOf(TRaySetupDumpRecord)]);
+end;
+
+function RaySetupOnly: Boolean;
+begin
+  Result := gRaySetupDumpPath <> '';
+end;
+
+function RaySetupDeterministic: Boolean;
+begin
+  Result := gRaySetupDeterministic;
+end;
+
+function RaySetupDeterministicThreadSeed(ThreadId: Integer): Integer;
+var
+  Mixed: Int64;
+begin
+  Mixed := Int64(ThreadId) * Int64($324594A1) + Int64($24563487);
+  Result := Integer(Cardinal(Mixed and $FFFFFFFF));
+end;
+
+procedure RaySetupConfigure(const DumpPath: String; Deterministic: Boolean);
+begin
+  gRaySetupDumpPath := DumpPath;
+  gRaySetupDeterministic := Deterministic;
+end;
+
+function GetRecordPtr(x, y: Integer): PRaySetupDumpRecord;
+var
+  idx: Integer;
+begin
+  Result := nil;
+  if (gRaySetupWidth <= 0) or (gRaySetupHeight <= 0) then Exit;
+  if (x < 0) or (x >= gRaySetupWidth) or (y < 0) or (y >= gRaySetupHeight) then Exit;
+  idx := y * gRaySetupWidth + x;
+  if (idx < 0) or (idx >= Length(gRaySetupRecords)) then Exit;
+  Result := @gRaySetupRecords[idx];
+end;
+
+procedure RaySetupBeginFrame(Width, Height: Integer);
+begin
+  EnsureRecordSize;
+  gRaySetupWidth := Width;
+  gRaySetupHeight := Height;
+  if RaySetupOnly and (Width > 0) and (Height > 0) then
+  begin
+    SetLength(gRaySetupRecords, Width * Height);
+    if Length(gRaySetupRecords) > 0 then
+      FillChar(gRaySetupRecords[0], Length(gRaySetupRecords) * SizeOf(TRaySetupDumpRecord), 0);
+  end
+  else
+    SetLength(gRaySetupRecords, 0);
+end;
+
+procedure RaySetupFinishFrame;
+var
+  Header: TRaySetupDumpHeader;
+  FS: TFileStream;
+  OutDir: String;
+begin
+  if not RaySetupOnly then Exit;
+  EnsureRecordSize;
+  OutDir := ExtractFilePath(ExpandFileName(gRaySetupDumpPath));
+  if (OutDir <> '') and (not DirectoryExists(OutDir)) then
+    ForceDirectories(OutDir);
+
+  FillChar(Header, SizeOf(Header), 0);
+  Header.Magic[0] := 'R';
+  Header.Magic[1] := 'A';
+  Header.Magic[2] := 'Y';
+  Header.Magic[3] := 'S';
+  Header.Magic[4] := 'E';
+  Header.Magic[5] := 'T';
+  Header.Magic[6] := 'P';
+  Header.Magic[7] := '1';
+  Header.Version := 1;
+  Header.Width := LongWord(gRaySetupWidth);
+  Header.Height := LongWord(gRaySetupHeight);
+  Header.RecordSize := LongWord(SizeOf(TRaySetupDumpRecord));
+  Header.Count := LongWord(Length(gRaySetupRecords));
+
+  FS := TFileStream.Create(gRaySetupDumpPath, fmCreate);
+  try
+    FS.WriteBuffer(Header, SizeOf(Header));
+    if Length(gRaySetupRecords) > 0 then
+      FS.WriteBuffer(gRaySetupRecords[0], Length(gRaySetupRecords) * SizeOf(TRaySetupDumpRecord));
+  finally
+    FS.Free;
+  end;
+end;
+
+procedure RaySetupCaptureRayReady(MCTparas: PMCTparameter; SeedBefore: Integer; x, y: Integer);
+var
+  Rec: PRaySetupDumpRecord;
+  It3D: TPIteration3Dext;
+  Aspect, CosVal: Double;
+begin
+  Rec := GetRecordPtr(x, y);
+  if Rec = nil then Exit;
+
+  FillChar(Rec^, SizeOf(TRaySetupDumpRecord), 0);
+  It3D := MCTparas^.pIt3Dext;
+  Rec^.x := x;
+  Rec^.y := y;
+  Rec^.thread_id := MCTparas^.iThreadId;
+  Rec^.seed_before_first_step := SeedBefore;
+  Rec^.cut_plane_hit := -1;
+  Rec^.ray_ready_captured := 1;
+  Rec^.camera_optic := MCTparas^.MCTCameraOptic;
+  Rec^.cut_options := MCTparas^.iCutOptions;
+  Rec^.bin_steps := MCTparas^.iDEAddSteps;
+  Rec^.inside_rendering := PascalBool(MCTparas^.bInsideRendering);
+  Rec^.calc_inside := PascalBool(MCTparas^.bCalcInside);
+  Rec^.in_and_out := PascalBool(MCTparas^.bInAndOutside);
+  Rec^.calc_sit := PascalByteBool(It3D^.CalcSIT);
+  Rec^.it_result := 0;
+  Rec^.max_it := It3D^.maxIt;
+  Rec^.vary_destop := PascalBool(MCTparas^.bVaryDEstop);
+  Rec^.cafx := MCTparas^.CAFX;
+  Rec^.cafy := MCTparas^.CAFY;
+  Rec^.fovx_off := MCTparas^.FOVXoff;
+  Rec^.fovx_mul := MCTparas^.FOVXmul;
+  Rec^.fovy := MCTparas^.FOVy;
+  Rec^.step_width := MCTparas^.StepWidth;
+  Rec^.de_stop := MCTparas^.DEstop;
+  Rec^.ray_ms_destop := MCTparas^.msDEstop;
+  Rec^.ray_mzz := MCTparas^.mZZ;
+  Rec^.zend := MCTparas^.Zend;
+  Rec^.start_destop := MCTparas^.DEstop;
+  Rec^.max_ray_length := MCTparas^.Zend;
+  Rec^.zzpos_mul := 1.0;
+  if MCTparas^.bVaryDEstop then
+  begin
+    if MCTparas^.MCTCameraOptic = 2 then
+      Aspect := 1.0
+    else
+    begin
+      CosVal := Cos(Sqrt(Sqr(MCTparas^.CAFX) + Sqr(MCTparas^.CAFY)));
+      if CosVal < 0.1 then Aspect := 0.1 else Aspect := CosVal;
+    end;
+    Rec^.de_mul_vary := MCTparas^.mctDEstopFactor / Aspect;
+    Rec^.de_mul_const := 1.0;
+  end
+  else
+  begin
+    Rec^.de_mul_vary := 0.0;
+    Rec^.de_mul_const := 1.0;
+  end;
+  Rec^.smooth_it := 0;
+  Rec^.rout := 0;
+  Rec^.otrap := 0;
+  Rec^.r_stop := It3D^.RStop;
+  Rec^.ddescale := MCTparas^.dDEscale;
+  Rec^.mct_de_offset := MCTparas^.mctDEoffset;
+  Rec^.mct_de_offset006 := MCTparas^.mctDEoffset006;
+  CopyVec3(Rec^.mvgrads_fov, MCTparas^.mVgradsFOV);
+  CopyVec3(Rec^.view_vec, MCTparas^.mVgradsFOV);
+  CopyVec3(Rec^.march_vec, MCTparas^.mVgradsFOV);
+  Rec^.ray_ready_start[0] := It3D^.C1;
+  Rec^.ray_ready_start[1] := It3D^.C2;
+  Rec^.ray_ready_start[2] := It3D^.C3;
+  Rec^.act_pos[0] := It3D^.C1;
+  Rec^.act_pos[1] := It3D^.C2;
+  Rec^.act_pos[2] := It3D^.C3;
+  CopyVec3(Rec^.ystart, MCTparas^.Ystart);
+  Rec^.vgrads0[0] := MCTparas^.Vgrads[0][0];
+  Rec^.vgrads0[1] := MCTparas^.Vgrads[0][1];
+  Rec^.vgrads0[2] := MCTparas^.Vgrads[0][2];
+  Rec^.vgrads1[0] := MCTparas^.Vgrads[1][0];
+  Rec^.vgrads1[1] := MCTparas^.Vgrads[1][1];
+  Rec^.vgrads1[2] := MCTparas^.Vgrads[1][2];
+
+  if HeadlessIsDiagPixel(x, y) then
+  begin
+    HeadlessEnterDiagPixel(x, y);
+    try
+      HeadlessTracePixel(Format(
+        'ray_setup_capture CAFY=%.17g CAFX=%.17g mvx=%.17g mvy=%.17g mvz=%.17g ' +
+        'vg0=%.17g,%.17g,%.17g vg1=%.17g,%.17g,%.17g vg2=%.17g,%.17g,%.17g x87_cw=$%.4x mxcsr=$%.8x',
+        [MCTparas^.CAFY, MCTparas^.CAFX,
+         MCTparas^.mVgradsFOV[0], MCTparas^.mVgradsFOV[1], MCTparas^.mVgradsFOV[2],
+         MCTparas^.Vgrads[0][0], MCTparas^.Vgrads[0][1], MCTparas^.Vgrads[0][2],
+         MCTparas^.Vgrads[1][0], MCTparas^.Vgrads[1][1], MCTparas^.Vgrads[1][2],
+         MCTparas^.Vgrads[2][0], MCTparas^.Vgrads[2][1], MCTparas^.Vgrads[2][2],
+         Get8087CW, ReadTraceMXCSR]));
+    finally
+      HeadlessLeaveDiagPixel;
+    end;
+  end;
+end;
+
+procedure RaySetupCaptureFirstCalcDEEnter(MCTparas: PMCTparameter; x, y, CutPlaneIndex: Integer; AfterCutPlane: Boolean);
+var
+  Rec: PRaySetupDumpRecord;
+  It3D: TPIteration3Dext;
+begin
+  Rec := GetRecordPtr(x, y);
+  if (Rec = nil) or (Rec^.calcde_enter_captured <> 0) then Exit;
+
+  It3D := MCTparas^.pIt3Dext;
+  Rec^.calcde_enter_captured := 1;
+  if AfterCutPlane then
+    Rec^.calcde_retry_index := 1
+  else
+    Rec^.calcde_retry_index := 0;
