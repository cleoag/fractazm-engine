           ParseResult.Description := CFdescription;
+
+          { Override x87 [CODE] bytecode with portable_math.dll SSE2
+            implementation when available.  See banner at top of unit.
+            MUST also flip bCPmemReserved to False — otherwise
+            AssignCustomFormula (see lines 664-670 above) will FastMove
+            4096 bytes from the DLL symbol address into a freshly
+            VirtualAlloc'd page, cloning a junk code snippet that runs
+            in place of the real formula.  The original VA page with
