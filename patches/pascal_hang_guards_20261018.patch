diff --git a/FormulaExecutionGuard.pas b/FormulaExecutionGuard.pas
new file mode 100644
index 0000000..6fbbcb7
--- /dev/null
+++ b/FormulaExecutionGuard.pas
@@ -0,0 +1,146 @@
+unit FormulaExecutionGuard;
+
+{$mode delphi}
+
+interface
+
+uses SysUtils, Windows;
+
+const
+  FormulaCallsWithoutProgressLimit = 1048576;
+
+type
+  EFormulaExecutionError = class(Exception);
+  TFormulaIterationGuard = record
+    HighWaterIteration: Integer;
+    CallsWithoutProgress: Cardinal;
+    VisitedSlots: Cardinal;
+    Driver: Integer;
+    TotalCalls: Cardinal;
+  end;
+
+procedure FormulaGuardInit(var Guard: TFormulaIterationGuard; Driver, StartSlot,
+  RepeatSlot, EndSlot: Integer);
+procedure FormulaGuardVisitInactive(var Guard: TFormulaIterationGuard;
+  CountedIteration, Slot: Integer);
+procedure FormulaGuardBefore(var Guard: TFormulaIterationGuard;
+  CountedIteration, Slot: Integer);
+procedure ReportFormulaWorkerFailure(const Stage: string; E: Exception;
+  StopFlag: PLongBool);
+function FormulaExecutionFailureText: string;
+procedure ClearFormulaExecutionFailure;
+
+implementation
+
+const
+  DriverNames: array[0..10] of PChar = (
+    'doHybridPas', 'doHybridPasDE', 'doHybrid4DPas', 'doHybrid4DDEPas',
+    'doInterpolHybridPas', 'doInterpolHybridPasDE', 'doInterpolHybridPas4D',
+    'doInterpolHybridPas4DDE', 'doHybridIFS3D', 'doHybridIFS3DnoVecIni',
+    'do3DalternateOTrap');
+
+var
+  FailureLock: TRTLCriticalSection;
+  FailureText: string;
+  FailurePending: LongInt = 0;
+
+procedure GuardFail(const Guard: TFormulaIterationGuard; const Reason: string;
+  Slot, CountedIteration: Integer);
+var Name: string;
+begin
+  Name := 'unknown';
+  if (Guard.Driver >= Low(DriverNames)) and (Guard.Driver <= High(DriverNames)) then
+    Name := string(DriverNames[Guard.Driver]);
+  raise EFormulaExecutionError.CreateFmt(
+    'formula iteration guard: driver=%s reason=%s slot=%d ItResultI=%d calls_without_progress=%d limit=%d',
+    [Name, Reason, Slot, CountedIteration, Guard.CallsWithoutProgress,
+     FormulaCallsWithoutProgressLimit]);
+end;
+
+procedure FormulaGuardInit(var Guard: TFormulaIterationGuard; Driver, StartSlot,
+  RepeatSlot, EndSlot: Integer);
+begin
+  Guard.HighWaterIteration := 0;
+  Guard.CallsWithoutProgress := 0;
+  Guard.VisitedSlots := 0;
+  Guard.Driver := Driver;
+  Guard.TotalCalls := 0;
+  if (Cardinal(StartSlot) > 5) or (Cardinal(RepeatSlot) > 5) or
+     (Cardinal(EndSlot) > 5) then
+    GuardFail(Guard, 'invalid_slot_range', StartSlot, 0);
+end;
+
+procedure FormulaGuardVisitInactive(var Guard: TFormulaIterationGuard;
+  CountedIteration, Slot: Integer);
+var Bit: Cardinal;
+begin
+  if Cardinal(Slot) > 5 then GuardFail(Guard, 'invalid_slot_range', Slot, CountedIteration);
+  Bit := Cardinal(1) shl Slot;
+  { No callback executes during this walk, so a repeated slot proves a cycle. }
+  if (Guard.VisitedSlots and Bit) <> 0 then
+    GuardFail(Guard, 'empty_cycle', Slot, CountedIteration);
+  Guard.VisitedSlots := Guard.VisitedSlots or Bit;
+end;
+
+procedure FormulaGuardBefore(var Guard: TFormulaIterationGuard;
+  CountedIteration, Slot: Integer);
+begin
+  Guard.VisitedSlots := 0;
+  if CountedIteration > Guard.HighWaterIteration then
+  begin
+    Guard.HighWaterIteration := CountedIteration;
+    Guard.CallsWithoutProgress := 0;
+  end;
+  { A work limit, not a proof that the input is mathematically nonterminating. }
+  if Guard.CallsWithoutProgress = FormulaCallsWithoutProgressLimit then
+    GuardFail(Guard, 'no_progress_budget', Slot, CountedIteration);
+  Inc(Guard.CallsWithoutProgress);
+  { Check sibling failure periodically without adding a lock to every dispatch. }
+  Guard.TotalCalls := (Guard.TotalCalls + 1) and $3FF;
+  if (Guard.TotalCalls = 0) and (InterlockedCompareExchange(FailurePending, 0, 0) <> 0) then
+    GuardFail(Guard, 'render_cancelled_after_worker_failure', Slot, CountedIteration);
+end;
+
+procedure ReportFormulaWorkerFailure(const Stage: string; E: Exception;
+  StopFlag: PLongBool);
+begin
+  { Workers only publish the first failure and request cancellation. Calling Halt
+    here would finalize shared units while sibling workers still use them. The
+    main thread reports the error after every worker has finished its finally. }
+  EnterCriticalSection(FailureLock);
+  try
+    if FailureText = '' then FailureText := Stage + ': ' + E.ClassName + ': ' + E.Message;
+    InterlockedExchange(FailurePending, 1);
+  finally
+    LeaveCriticalSection(FailureLock);
+  end;
+  if StopFlag <> nil then InterlockedExchange(PLongInt(StopFlag)^, 1);
+end;
+
+function FormulaExecutionFailureText: string;
+begin
+  EnterCriticalSection(FailureLock);
+  try
+    Result := FailureText;
+  finally
+    LeaveCriticalSection(FailureLock);
+  end;
+end;
+
+procedure ClearFormulaExecutionFailure;
+begin
+  { Called on the UI thread only, after all workers of the previous job stopped. }
+  EnterCriticalSection(FailureLock);
+  try
+    FailureText := '';
+    InterlockedExchange(FailurePending, 0);
+  finally
+    LeaveCriticalSection(FailureLock);
+  end;
+end;
+
+initialization
+  InitializeCriticalSection(FailureLock);
+finalization
+  DeleteCriticalSection(FailureLock);
+end.
