+program test_pm;
+{$mode delphi}
+uses SysUtils;
+
+function pm_sin_bits(x_bits: QWord): QWord; cdecl; external 'portable_math.dll' name 'pm_sin_bits';
+function pm_sin(x: Double): Double; cdecl; external 'portable_math.dll' name 'pm_sin';
+
+var
+  xb, rb: QWord;
+  x, v: Double;
+  b: QWord;
+begin
+  { Exact bits of 1.23456789 as MSVC/Python parse it. }
+  xb := QWord($3FF3C0CA4283DE1B);
+  WriteLn('--- Test 1: pm_sin_bits via integer path ---');
+  WriteLn('Input bits : 0x', IntToHex(Int64(xb), 16));
+  rb := pm_sin_bits(xb);
+  WriteLn('Output bits: 0x', IntToHex(Int64(rb), 16));
+  WriteLn('Expected   : 0x3FEE354B7E843329');
+
+  WriteLn('--- Test 2: pm_sin via double literal ---');
+  v := pm_sin(1.23456789);
+  Move(v, b, SizeOf(b));
+  WriteLn('pm_sin bits: 0x', IntToHex(Int64(b), 16));
+
+  WriteLn('--- Test 3: literal to bits ---');
+  x := 1.23456789;
+  Move(x, b, SizeOf(b));
+  WriteLn('Pascal literal  1.23456789  bits: 0x', IntToHex(Int64(b), 16));
+end.
