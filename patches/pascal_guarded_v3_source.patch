+unit ParityTrace;
+
+{$mode delphi}
+
+{ Pascal emitter for the Pascal<->C++ parity trace.
+  See docs/PARITY_TRACE.md and comparison/tools/parity_trace_schema.json
+  for the full contract. This unit is compiled unconditionally; runtime
+  activation is gated via HeadlessParityTraceEnabled. }
+
+interface
+
+uses SysUtils;
+
+type
+  TParityTraceLevel = (ptlCheckpoint, ptlDetailSelected, ptlDetailAll);
+
+{ Called once after HeadlessParseArgs has populated HeadlessParityTrace*.
+  Opens the trace file, writes the canary stage.
+  Safe to call multiple times (re-init is idempotent). }
+procedure ParityTraceInit(const OutputPath: String;
+                          TargetX, TargetY: Integer;
+                          Level: TParityTraceLevel;
+                          const DetailStagesCsv: String;
+                          const StartStage, EndStage: String);
+
+{ Close the trace file. Call at end of render. }
+procedure ParityTraceClose;
+
+{ True when parity trace is active for this specific pixel.
+  Use this to gate emission call sites cheaply. }
+function ParityTraceActiveForPixel(X, Y: Integer): Boolean;
+
+{ Pixel-context API: top-level loop sets (x,y) once via EnterPixel, then
+  deeply-nested hook sites (e.g. inside CalcDEfull) use ParityTraceActive
+  and ParityTraceBeginCurrentStage without re-passing coordinates. }
+procedure ParityTraceEnterPixel(X, Y: Integer);
+procedure ParityTraceLeavePixel;
+function ParityTraceActive: Boolean;
+procedure ParityTraceBeginCurrentStage(const Stage: String);
+
+{ Stage lifecycle: begin, add fields in schema order, end (emits line) }
+procedure ParityTraceBeginStage(const Stage: String; X, Y: Integer);
+procedure ParityTraceAddDouble12(const Name: String; V: Double);
+procedure ParityTraceAddDouble17(const Name: String; V: Double);
+procedure ParityTraceAddInt(const Name: String; V: Int64);
+procedure ParityTraceAddBoolNeg1(const Name: String; V: Boolean);
+procedure ParityTraceAddString(const Name, V: String);
+procedure ParityTraceAddHex64(const Name: String; V: QWord);
+procedure ParityTraceEndStage;
+
+{ Formatting helpers, exposed for callers that need the strings elsewhere }
+function FNV1a64(const Input: AnsiString): QWord;
+function DoubleBitsHex(V: Double): String;
+function FormatDouble12(V: Double): String;
+function FormatDouble17(V: Double): String;
+function FormatBoolNeg1(B: Boolean): String;
+function Hex64ToStr(V: QWord): String;
+
+implementation
+
+uses Math, Classes, SyncObjs;
+
+const
+  FNV_OFFSET_BASIS: QWord = QWord($CBF29CE484222325);
+  FNV_PRIME:        QWord = QWord($00000100000001B3);
+  CANONICAL_NAN_BITS:  QWord = QWord($7FF8000000000000);
+  POSITIVE_INF_BITS:   QWord = QWord($7FF0000000000000);
+  NEGATIVE_INF_BITS:   QWord = QWord($FFF0000000000000);
+  NEGATIVE_ZERO_BITS:  QWord = QWord($8000000000000000);
+
+var
+  gActive: Boolean = False;
+  gOutputPath: String = '';
+  gTargetX: Integer = -1;
+  gTargetY: Integer = -1;
+  gLevel: TParityTraceLevel = ptlCheckpoint;
+  gDetailStages: TStringList = nil;
+  gStartStage: String = '';
+  gEndStage: String = '';
+  gStartReached: Boolean = True;
+  gEndReached: Boolean = False;
+  gFile: TextFile;
+  gFileOpen: Boolean = False;
+  gLock: TCriticalSection = nil;
+
+threadvar
+  { Current-stage accumulator state }
+  gCurStage: String;
+  gCurX: Integer;
+  gCurY: Integer;
+  gCurPayload: String;     { textual payload "k1=v1 k2=v2 ..." }
+  gCurHashInput: String;   { "k1=v1bits\nk2=v2bits\n..." }
+  gInStage: Boolean;
+
+  { Pixel context set by EnterPixel — used by deep hook sites }
+  gPixelX: Integer;
+  gPixelY: Integer;
+  gPixelActive: Boolean;
+
+
+{ === Formatting helpers === }
+
+function Hex64ToStr(V: QWord): String;
+begin
+  Result := '0x' + UpperCase(IntToHex(Int64(V), 16));
+end;
+
+function DoubleToBits(V: Double): QWord; inline;
+begin
+  Move(V, Result, SizeOf(Result));
+end;
+
+function DoubleBitsHex(V: Double): String;
+begin
+  if IsNaN(V) then
+    Result := Hex64ToStr(CANONICAL_NAN_BITS)
+  else
+    Result := Hex64ToStr(DoubleToBits(V));
+end;
+
+function FormatDoubleSpecial(V: Double; out S: String): Boolean;
+begin
+  Result := True;
+  if IsNaN(V) then S := 'nan'
+  else if IsInfinite(V) then
+  begin
+    if V > 0 then S := 'inf' else S := '-inf';
+  end
+  else
+    Result := False;
+end;
+
+function FormatDouble12(V: Double): String;
+var
+  Special: String;
+begin
+  if FormatDoubleSpecial(V, Special) then
+    Exit(Special);
+  { FPC ffGeneral with precision 12 == roughly %.12g. Decimal separator
+    is forced to '.' via DefaultFormatSettings init below. }
+  Result := FloatToStrF(V, ffGeneral, 12, 0);
+end;
+
+function FormatDouble17(V: Double): String;
+var
+  Special: String;
+begin
+  if FormatDoubleSpecial(V, Special) then
+    Exit(Special);
+  Result := FloatToStrF(V, ffGeneral, 17, 0);
+end;
+
+function FormatBoolNeg1(B: Boolean): String;
+begin
+  if B then Result := '-1' else Result := '0';
+end;
+
+function FNV1a64(const Input: AnsiString): QWord;
+var
+  I: Integer;
+begin
+  Result := FNV_OFFSET_BASIS;
+  for I := 1 to Length(Input) do
+  begin
+    Result := Result xor QWord(Byte(Input[I]));
+    Result := Result * FNV_PRIME;
+  end;
+end;
+
+
+{ === Init / teardown === }
+
+procedure ParseDetailStages(const Csv: String);
+var
+  Parts: TStringList;
+  I: Integer;
+  S: String;
+begin
+  if gDetailStages = nil then
+    gDetailStages := TStringList.Create;
+  gDetailStages.Clear;
+  if Csv = '' then Exit;
+  Parts := TStringList.Create;
+  try
+    Parts.CommaText := Csv;
+    for I := 0 to Parts.Count - 1 do
+    begin
+      S := Trim(Parts[I]);
+      if S <> '' then
+        gDetailStages.Add(S);
+    end;
+  finally
+    Parts.Free;
+  end;
+end;
+
+function IsDetailStage(const Stage: String): Boolean;
+begin
+  if gLevel = ptlDetailAll then Exit(True);
+  if gLevel = ptlCheckpoint then Exit(False);
+  Result := (gDetailStages <> nil) and (gDetailStages.IndexOf(Stage) >= 0);
+end;
+
+{ Vendored portable sin/cos/log for canary — matches C++ side bit-for-bit. }
+function pm_sin_canary(x: Double): Double; cdecl; external 'portable_math.dll' name 'pm_sin';
+function pm_cos_canary(x: Double): Double; cdecl; external 'portable_math.dll' name 'pm_cos';
+function pm_log_canary(x: Double): Double; cdecl; external 'portable_math.dll' name 'pm_log';
+
+procedure EmitCanary;
+var
+  One, Three, Zero, PosOne: Double;
+  OneThird, NanSample, PosInf, NegInf: Double;
+  TestAngle, TestLogArg: Double;
+begin
+  { Force runtime Double arithmetic — FPC compile-time folds 1.0/3.0 in
+    Single precision which loses bits. We want the canonical Double
+    representation of 1/3 (0x3FD5555555555555), matching Python/C++. }
+  One := 1.0;
+  Three := 3.0;
+  Zero := 0.0;
+  PosOne := 1.0;
+  OneThird := One / Three;
+  NanSample := Zero / Zero;      { quiet NaN }
+  PosInf := PosOne / Zero;
+  NegInf := -PosInf;
+  TestAngle := 1.23456789;
+  TestLogArg := 2.718281828;     { close-to-e for log test }
+  ParityTraceBeginStage('_canary', -1, -1);
+  ParityTraceAddDouble12('pi', 3.141592653589793);
+  ParityTraceAddDouble12('one_third', OneThird);
+  ParityTraceAddDouble12('tenth', 0.1);
+  ParityTraceAddDouble12('neg_zero', -0.0);
+  ParityTraceAddDouble12('nan_sample', NanSample);
+  ParityTraceAddDouble12('neg_inf', NegInf);
+  ParityTraceAddBoolNeg1('bool_true', True);
+  ParityTraceAddBoolNeg1('bool_false', False);
+  ParityTraceAddDouble12('pm_sin_test', pm_sin_canary(TestAngle));
+  ParityTraceAddDouble12('pm_cos_test', pm_cos_canary(TestAngle));
+  ParityTraceAddDouble12('pm_log_test', pm_log_canary(TestLogArg));
+  ParityTraceEndStage;
+end;
+
+procedure ParityTraceInit(const OutputPath: String;
+                          TargetX, TargetY: Integer;
+                          Level: TParityTraceLevel;
+                          const DetailStagesCsv: String;
+                          const StartStage, EndStage: String);
+begin
+  if gActive then
+    ParityTraceClose;
+
+  if (OutputPath = '') or (TargetX < 0) or (TargetY < 0) then
+  begin
+    gActive := False;
+    Exit;
+  end;
+
+  if gLock = nil then
+    gLock := TCriticalSection.Create;
+
+  gOutputPath := OutputPath;
+  gTargetX := TargetX;
+  gTargetY := TargetY;
+  gLevel := Level;
+  ParseDetailStages(DetailStagesCsv);
+  gStartStage := StartStage;
+  gEndStage := EndStage;
+  gStartReached := (StartStage = '');
+  gEndReached := False;
+
+  try
+    AssignFile(gFile, OutputPath);
+    Rewrite(gFile);
+    gFileOpen := True;
+  except
+    gFileOpen := False;
+    gActive := False;
+    Exit;
+  end;
+
+  gActive := True;
+  EmitCanary;
+end;
+
+procedure ParityTraceClose;
+begin
+  if gActive and gFileOpen then
+  begin
+    try
+      CloseFile(gFile);
+    except
+    end;
+  end;
+  gFileOpen := False;
+  gActive := False;
+  gInStage := False;
+end;
+
+
+{ === Activation predicate === }
+
+function ParityTraceActiveForPixel(X, Y: Integer): Boolean;
+begin
+  Result := gActive and (X = gTargetX) and (Y = gTargetY);
+end;
+
+procedure ParityTraceEnterPixel(X, Y: Integer);
+begin
+  if not gActive then Exit;
+  { Implicit leave on re-entry so callers that skip LeavePixel via Continue
+    (e.g. RaySetup early-outs in CalcThread) do not leak pixel activation
+    into subsequent iterations. }
+  gPixelActive := False;
+  gPixelX := -1;
+  gPixelY := -1;
+  if (X = gTargetX) and (Y = gTargetY) then
+  begin
+    gPixelX := X;
+    gPixelY := Y;
+    gPixelActive := True;
+  end;
+end;
+
+procedure ParityTraceLeavePixel;
+begin
+  gPixelActive := False;
+  gPixelX := -1;
+  gPixelY := -1;
+end;
+
+function ParityTraceActive: Boolean;
+begin
+  Result := gActive and gPixelActive;
+end;
+
+procedure ParityTraceBeginCurrentStage(const Stage: String);
+begin
+  ParityTraceBeginStage(Stage, gPixelX, gPixelY);
+end;
+
+
+{ === Stage lifecycle === }
+
+procedure ParityTraceBeginStage(const Stage: String; X, Y: Integer);
+begin
+  if not gActive then Exit;
+
+  { Stage range filtering: startStage means "begin logging at this stage".
+    endStage means "stop logging after this stage". }
+  if (not gStartReached) and (Stage = gStartStage) then
+    gStartReached := True;
+
+  if gEndReached then Exit;
+  if not gStartReached then Exit;
+
+  if gLock <> nil then gLock.Acquire;
+  gInStage := True;
+  gCurStage := Stage;
+  gCurX := X;
+  gCurY := Y;
+  gCurPayload := '';
+  gCurHashInput := '';
+end;
+
+procedure AppendField(const Name, TextValue, HashValue: String);
+begin
+  if not gInStage then Exit;
+  if gCurPayload <> '' then gCurPayload := gCurPayload + ' ';
+  gCurPayload := gCurPayload + Name + '=' + TextValue;
+
+  if gCurHashInput <> '' then gCurHashInput := gCurHashInput + #10;
+  gCurHashInput := gCurHashInput + Name + '=' + HashValue;
+end;
+
+procedure ParityTraceAddDouble12(const Name: String; V: Double);
+var
+  BitsHex: String;
+begin
+  if not gInStage then Exit;
+  BitsHex := DoubleBitsHex(V);
+  { Emit paired name and name_bits (always). Hash uses bits, not text. }
+  AppendField(Name, FormatDouble12(V), BitsHex);
+  AppendField(Name + '_bits', BitsHex, BitsHex);
+end;
+
+procedure ParityTraceAddDouble17(const Name: String; V: Double);
+var
+  BitsHex: String;
+begin
+  if not gInStage then Exit;
+  BitsHex := DoubleBitsHex(V);
+  AppendField(Name, FormatDouble17(V), BitsHex);
+  AppendField(Name + '_bits', BitsHex, BitsHex);
+end;
+
+procedure ParityTraceAddInt(const Name: String; V: Int64);
+var S: String;
+begin
+  if not gInStage then Exit;
+  S := IntToStr(V);
+  AppendField(Name, S, S);
+end;
+
+procedure ParityTraceAddBoolNeg1(const Name: String; V: Boolean);
+var S: String;
+begin
+  if not gInStage then Exit;
+  S := FormatBoolNeg1(V);
+  AppendField(Name, S, S);
+end;
+
+procedure ParityTraceAddString(const Name, V: String);
+begin
+  if not gInStage then Exit;
+  AppendField(Name, V, V);
+end;
+
+procedure ParityTraceAddHex64(const Name: String; V: QWord);
+var S: String;
+begin
+  if not gInStage then Exit;
+  S := Hex64ToStr(V);
+  AppendField(Name, S, S);
+end;
+
+procedure ParityTraceEndStage;
+var
+  Checksum: QWord;
+  Line: String;
+  ChecksumStr: String;
+  DetailMode: Boolean;
+begin
+  if not gActive then Exit;
+  if not gInStage then Exit;
+
+  try
+    Checksum := FNV1a64(AnsiString(gCurHashInput));
+    ChecksumStr := Hex64ToStr(Checksum);
+    DetailMode := IsDetailStage(gCurStage);
+
+    Line := 'stage=' + gCurStage + ' x=' + IntToStr(gCurX) +
+            ' y=' + IntToStr(gCurY);
+
+    if DetailMode and (gCurPayload <> '') then
+      Line := Line + ' ' + gCurPayload;
+
+    Line := Line + ' checksum=' + ChecksumStr;
+
+    if gFileOpen then
+    begin
+      WriteLn(gFile, Line);
+      Flush(gFile);
+    end;
+
+    { End-stage filter: stop after this stage if it matches endStage. }
+    if (gEndStage <> '') and (gCurStage = gEndStage) then
+      gEndReached := True;
+  finally
+    gInStage := False;
+    gCurPayload := '';
+    gCurHashInput := '';
+    if gLock <> nil then gLock.Release;
+  end;
+end;
+
+initialization
+  DefaultFormatSettings.DecimalSeparator := '.';
+  DefaultFormatSettings.ThousandSeparator := #0;
+
+finalization
+  ParityTraceClose;
+  if gDetailStages <> nil then FreeAndNil(gDetailStages);
+  if gLock <> nil then FreeAndNil(gLock);
+
+end.
