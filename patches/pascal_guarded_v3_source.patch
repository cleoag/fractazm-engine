 implementation
 
-uses Math, DivUtils, LightAdjust, Math3D, SysUtils;
+uses Math, DivUtils, LightAdjust, Math3D, SysUtils, HeadlessRender, FormulaExecutionGuard;
+
+procedure InitDispatchGuard(var Guard: TFormulaIterationGuard;
+  PIteration3D: TPIteration3D; Driver: Integer);
