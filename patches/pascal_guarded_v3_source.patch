+unit KnownFormulaCodeGuard;
+
+{$mode delphi}
+{$asmmode intel}
+
+interface
+
+const KnownFormulaBodyLimit = 1048576;
+
+{ Only exact shipped i386 CODE is instrumented. Files and prepared parameters
+  remain unchanged. The added limit counts actual bodies, not requested depth. }
+function InstallKnownFormulaCodeGuard(Code: Pointer; CodeSize, Capacity: Integer;
+  const FormulaName: string): Boolean;
+
+implementation
+
+uses Windows, SysUtils, FormulaExecutionGuard;
+
+{$I KnownFormulaCodeBytes.inc}
+
+procedure FailKnownFormulaCode(Kind: Integer; CompletedBodies: Cardinal);
+var CW: Word;
+    Name, Reason: string;
+begin
+  { FPC i386 exceptions restore the enclosing Pascal try frame. Clear an
+    abandoned raw formula's x87 operands but preserve its caller's control word
+    before creating the exception. No partial formula result is published. }
+  asm
+    fnstcw CW
+    fninit
+    fldcw CW
+  end;
+  case Kind of
+    0: Name := 'TrifoxComplexAngles';
+    1: Name := '_e_3Dtess';
+    2: Name := '_IFS_tess';
+    3: Name := 'Knots2IFS';
+  else Name := 'unknown'; end;
+  if Kind = 0 then Reason := 'zero_integer_power' else Reason := 'body_work_budget';
+  raise EFormulaExecutionError.CreateFmt(
+    'formula code guard: formula=%s reason=%s completed_bodies=%d limit=%d',
+    [Name, Reason, CompletedBodies, KnownFormulaBodyLimit]);
+end;
+
+function InstallKnownFormulaCodeGuard(Code: Pointer; CodeSize, Capacity: Integer;
+  const FormulaName: string): Boolean;
+var Kind, Pos, Stub, PatchAt, Stolen, FailureBranch1, FailureBranch2,
+    FailureAt, I: Integer;
+    ExpectedName, BareName: string;
+    Original: array[0..15] of Byte;
+
+  function ByteAt(Offset: Integer): PByte;
+  begin
+    Result := PByte(PtrUInt(Code) + Cardinal(Offset));
+  end;
+
+  procedure ByteValue(Value: Byte);
+  begin
+    if Pos >= Capacity then raise EFormulaExecutionError.Create('formula code guard: insufficient code capacity');
+    ByteAt(Pos)^ := Value;
+    Inc(Pos);
+  end;
+
+  procedure DWordValue(Value: Cardinal);
+  begin
+    if Pos + 4 > Capacity then raise EFormulaExecutionError.Create('formula code guard: insufficient code capacity');
+    Move(Value, ByteAt(Pos)^, 4);
+    Inc(Pos, 4);
+  end;
+
+  procedure JumpTo(Target: Integer);
+  begin
+    ByteValue($E9);
+    DWordValue(Cardinal(Target - (Pos + 4)));
+  end;
+
+  procedure FailureJump(Condition: Byte; out Offset: Integer);
+  begin
+    ByteValue($0F); ByteValue(Condition);
+    Offset := Pos;
+    DWordValue(0);
+  end;
+
+  procedure FixFailureJump(Offset: Integer);
+  var Delta: Integer;
+  begin
+    Delta := FailureAt - (Offset + 4);
+    Move(Delta, ByteAt(Offset)^, 4);
+  end;
+
+begin
+  Result := False;
+  if (Code = nil) or (CodeSize <= 0) or (CodeSize > Capacity) then Exit;
+  Kind := -1;
+  if (CodeSize = SizeOf(TrifoxCode)) and CompareMem(Code, @TrifoxCode[0], CodeSize) then Kind := 0;
+  if (CodeSize = SizeOf(E3DTessCode)) and CompareMem(Code, @E3DTessCode[0], CodeSize) then Kind := 1;
+  if (CodeSize = SizeOf(IFSTessCode)) and CompareMem(Code, @IFSTessCode[0], CodeSize) then Kind := 2;
+  if (CodeSize = SizeOf(KnotsCode)) and CompareMem(Code, @KnotsCode[0], CodeSize) then Kind := 3;
+  BareName := ChangeFileExt(ExtractFileName(FormulaName), '');
+  if Kind < 0 then
+  begin
+    if SameText(BareName, 'TrifoxComplexAngles') or SameText(BareName, '_e_3Dtess') or
+       SameText(BareName, '_IFS_tess') or SameText(BareName, 'Knots2IFS') then
+      raise EFormulaExecutionError.CreateFmt(
+        'formula code guard: formula=%s reason=unrecognized_code_variant', [BareName]);
+    Exit;
+  end;
+  if SizeOf(Pointer) <> 4 then
+    raise EFormulaExecutionError.Create('formula code guard requires i386');
+  if Capacity < CodeSize + 128 then
+    raise EFormulaExecutionError.Create('formula code guard: insufficient code capacity');
+
+  case Kind of
+    0: begin PatchAt := $0B; Stolen := 5; ExpectedName := 'TrifoxComplexAngles'; end;
+    1: begin PatchAt := $86; Stolen := 6; ExpectedName := '_e_3Dtess'; end;
+    2: begin PatchAt := $95; Stolen := 10; ExpectedName := '_IFS_tess'; end;
+    3: begin PatchAt := $73; Stolen := 7; ExpectedName := 'Knots2IFS'; end;
+  end;
+  Move(ByteAt(PatchAt)^, Original, Stolen);
+  Stub := (CodeSize + 15) and not 15;
+  Pos := Stub;
+  FailureBranch2 := -1;
+  ByteValue($9C); { pushfd: fast path preserves all incoming integer flags }
+  case Kind of
+    0: begin
+      ByteValue($83); ByteValue($7F); ByteValue($F4); ByteValue(0); { cmp [edi-12],0 }
+      FailureJump($84, FailureBranch1);
+      ByteValue($83); ByteValue($7F); ByteValue($E4); ByteValue(0); { cmp [edi-28],0 }
+      FailureJump($84, FailureBranch2);
+    end;
+    1, 2: begin
+      ByteValue($81); ByteValue($7D);
+      if Kind = 1 then ByteValue($D4) else ByteValue($C4);
+      DWordValue(KnownFormulaBodyLimit); { existing monotonically increasing count }
+      FailureJump($83, FailureBranch1); { jae: reject before body limit+1 }
+    end;
+    3: begin
+      ByteValue($50); { push eax }
+      ByteValue($8B); ByteValue($47); ByteValue($9C); { mov eax,[edi-100] }
+      ByteValue($29); ByteValue($D0); { sub eax,edx: completed bodies; negative count first body =0 }
+      ByteValue($3D); DWordValue(KnownFormulaBodyLimit);
+      FailureJump($83, FailureBranch1);
+      ByteValue($58); { pop eax }
+    end;
+  end;
+  ByteValue($9D); { popfd }
+  if Kind = 2 then
+  begin
+    { Relocate the stolen JL explicitly. No target enters the stolen block. }
+    for I := 0 to 3 do ByteValue(Original[I]);
+    ByteValue($0F); ByteValue($8C);
+    DWordValue(Cardinal($182 - (Pos + 4)));
+  end
+  else for I := 0 to Stolen - 1 do ByteValue(Original[I]);
+  JumpTo(PatchAt + Stolen);
+  FailureAt := Pos;
+  if Kind = 3 then ByteValue($58);
+  ByteValue($9D);
+  { Restore the raw formula's own frame before entering Pascal exception code.
+    In particular Knots uses a 50-byte stack allocation without an EBP frame;
+    raising through that raw frame is not supported by FPC's i386 unwinder.
+    A tail jump gives the Pascal helper the real caller return address. }
+  if Kind = 3 then
+  begin
+    ByteValue($83); ByteValue($C4); ByteValue($32); { add esp,50 }
+  end
+  else
+  begin
+    ByteValue($5F); ByteValue($5E); { pop edi,esi }
+    if Kind <> 0 then ByteValue($5B); { pop ebx }
+    ByteValue($8B); ByteValue($E5); ByteValue($5D); { mov esp,ebp; pop ebp }
+  end;
+  ByteValue($B8); DWordValue(Cardinal(Kind)); { EAX first Pascal register argument }
+  ByteValue($BA);
+  if Kind = 0 then DWordValue(0) else DWordValue(KnownFormulaBodyLimit);
+  ByteValue($B9); DWordValue(Cardinal(@FailKnownFormulaCode));
+  ByteValue($FF); ByteValue($E1); { jmp ecx; helper always raises }
+  ByteValue($0F); ByteValue($0B); { ud2: cannot silently continue if helper ever returns }
+  FixFailureJump(FailureBranch1);
+  if FailureBranch2 >= 0 then FixFailureJump(FailureBranch2);
+  Pos := PatchAt;
+  JumpTo(Stub);
+  for I := 5 to Stolen - 1 do ByteValue($90);
+  if not FlushInstructionCache(GetCurrentProcess, Code, Capacity) then
+    raise EFormulaExecutionError.CreateFmt('formula code guard: instruction cache failure (%s)', [ExpectedName]);
+  Result := True;
+end;
+
+end.
