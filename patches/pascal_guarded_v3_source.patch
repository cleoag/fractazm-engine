+procedure TMCForm.RenderHeadlessFixed(Header: TPMandHeader10; Samples: Integer);
+var i: Integer; Active: Boolean; Started: QWord; DumpPath: String; DumpFile: TextFile; V: TSVec;
+begin
+  if (Samples < 1) or (Samples > 65535) then raise Exception.Create('Invalid MC sample count');
+  PreComputeHaltonSequence;
+  IniHeaderPointers;
+  AssignHeader(@MCparas, Header);
+  IniCFsFromHAddon(MCparas.PCFAddon, MCparas.PHCustomF);
+  MCparas.TilingOptions := 0;
+  MCparas.MClastY := 0;
+  withZBuffer := False;
+  paintZBuffer := False;
+  MakeLightValsFromHeaderLight(@MCparas, @MCHeaderLightVals, 1, MCparas.bStereoMode);
+  SetLength(siLightMC, MCparas.Width * MCparas.Height);
