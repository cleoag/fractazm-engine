+            SPosX := AddSVecWeight(SPosY, SPosXadd, ppXplus + x - 1);
+          PLV.xPos := (x + ppXplus) * dWid;
+          CalcViewVec(@PLV, aspect);
+          CalcObjPos(PLV, PaintParameter, PsiLight, @SPosX);
+          if RepaintCounter <> ppLocalCounter then Break;
+          if HeadlessDiagPixelActive then
+            HeadlessResetDiagPixel;
+          if HeadlessIsDiagPixel(x - 1, y) then
+            HeadlessEnterDiagPixel(x - 1, y);
+          try
+            PLVals.lvCalcPixelcolor(PSL, PsiLight, PLVals, @PLV);
+          finally
+            if HeadlessIsDiagPixel(x - 1, y) and HeadlessDiagPixelActive then
+              HeadlessLeaveDiagPixel;
+          end;
+          Inc(PSL);
+          Inc(PsiLight);
+        end;
+        Inc(y);
+      end;
