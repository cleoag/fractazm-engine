+                 1, 0, False, @siLightMCExt[0], False) then
+    raise Exception.Create('MC setup failed');
+  if MCctstats.iTotalThreadCount < 1 then raise Exception.Create('MC has no workers');
+  Started := GetTickCount64;
+  repeat
+    Active := False;
+    for i := 1 to MCctstats.iTotalThreadCount do
+      Active := Active or (MCctstats.CTrecords[i].isActive <> 0);
+    if Active then Sleep(1);
+    if GetTickCount64 - Started > 120000 then
+    begin
+      MCCalcStop := True;
+      raise Exception.Create('MC reference timeout');
+    end;
+  until not Active;
+  for i := 0 to High(siLightMC) do
+    if siLightMC[i].RayCount <> Samples then raise Exception.Create('Incomplete MC reference samples');
+  DumpPath := GetEnvironmentVariable('MB3D_HEADLESS_MC_DUMP');
+  if DumpPath <> '' then
+  begin
+    AssignFile(DumpFile, DumpPath); Rewrite(DumpFile);
+    try
+      WriteLn(DumpFile, MCparas.Width, ' ', MCparas.Height, ' ', Ord(MCHeaderLightVals.bCalcPixColSqr));
+      for i := 0 to High(siLightMC) do
+      begin
+        V := MCRGBToSVec(@siLightMC[i]);
+        WriteLn(DumpFile, V[0]:24:12, ' ', V[1]:24:12, ' ', V[2]:24:12);
+      end;
+    finally CloseFile(DumpFile); end;
+  end;
+  PaintMC(@MCparas, True);
+end;
