{
  "$comment": "Stage and field inventory for Pascal/C++ schema traces. See docs/PARITY_TRACE.md for the contract and current validator limitations. Extend alongside both emitters.",
  "version": 2,
  "hash_algorithm": "fnv1a64",
  "field_types": {
    "double12": "12-significant-digit textual form plus paired <name>_bits hex64",
    "double17": "17-significant-digit textual form plus paired <name>_bits hex64",
    "int": "plain decimal integer",
    "bool_neg1": "-1 for true, 0 for false",
    "hex64": "0x-prefixed 16 uppercase hex digits",
    "string": "ASCII, no whitespace, no quoting",
    "checksum": "fnv1a64 output as hex64"
  },
  "checkpoint_mode": {
    "$comment": "Hash follows emitter call order. A floating field contributes name=0xBITS and name_bits=0xBITS as two lines. Other fields contribute one name=text line. Join with LF; no trailing LF. stages_order is a pipeline inventory, not a grammar; stages repeat during marching and AO.",
    "hash_input_format": "name=0xBITS\nname_bits=0xBITS\ninteger=value"
  },
  "stages": {
    "_canary": {
      "description": "Pre-render format and computed portable-math self-test. Mismatch may indicate serialization, floating-point state or math drift. C++ emits checksum only; Pascal includes payload in detailed mode.",
      "pre_render": true,
      "fields": [
        {
          "name": "pi",
          "type": "double12",
          "fixed_value": 3.141592653589793
        },
        {
          "name": "one_third",
          "type": "double12",
          "fixed_value": 0.3333333333333333
        },
        {
          "name": "tenth",
          "type": "double12",
          "fixed_value": 0.1
        },
        {
          "name": "neg_zero",
          "type": "double12",
          "fixed_value": -0.0
        },
        {
          "name": "nan_sample",
          "type": "double12",
          "fixed_value": "nan"
        },
        {
          "name": "neg_inf",
          "type": "double12",
          "fixed_value": "-inf"
        },
        {
          "name": "bool_true",
          "type": "bool_neg1",
          "fixed_value": true
        },
        {
          "name": "bool_false",
          "type": "bool_neg1",
          "fixed_value": false
        },
        {
          "name": "pm_sin_test",
          "type": "double12",
          "computed_expression": "pm_sin(1.23456789)"
        },
        {
          "name": "pm_cos_test",
          "type": "double12",
          "computed_expression": "pm_cos(1.23456789)"
        },
        {
          "name": "pm_log_test",
          "type": "double12",
          "computed_expression": "pm_log(2.718281828)"
        }
      ]
    },
    "ray_ready": {
      "description": "Primary ray prepared at pixel (x,y), before CalcDE is called",
      "pre_render": false,
      "fields": [
        {
          "name": "mZZ",
          "type": "double12",
          "source_pascal": "CalcThread.pas mZZ local",
          "source_cpp": "ray_marcher.cpp ray_ready emission"
        },
        {
          "name": "CAFX",
          "type": "double12"
        },
        {
          "name": "CAFY",
          "type": "double12"
        }
      ]
    },
    "calcde_enter": {
      "description": "Entry to CalcDEfull - input state before any iteration",
      "pre_render": false,
      "fields": [
        {
          "name": "C1",
          "type": "double12"
        },
        {
          "name": "C2",
          "type": "double12"
        },
        {
          "name": "C3",
          "type": "double12"
        },
        {
          "name": "RStop",
          "type": "double12"
        },
        {
          "name": "maxIt",
          "type": "int"
        },
        {
          "name": "DEoption",
          "type": "int"
        },
        {
          "name": "bInsideRendering",
          "type": "bool_neg1"
        },
        {
          "name": "dDEscale",
          "type": "double12"
        },
        {
          "name": "mctDEoffset",
          "type": "double12"
        }
      ]
    },
    "calcde_after_orbit": {
      "description": "SmoothItD is canonical NaN while CalcSIT=0 (inactive state).",
      "pre_render": false,
      "fields": [
        {
          "name": "ItResultI",
          "type": "int"
        },
        {
          "name": "Rout",
          "type": "double12"
        },
        {
          "name": "OTrap",
          "type": "double12"
        },
        {
          "name": "SmoothItD",
          "type": "double12"
        },
        {
          "name": "bCalcInside",
          "type": "bool_neg1"
        },
        {
          "name": "CalcSIT",
          "type": "bool_neg1"
        }
      ]
    },
    "calcde_result": {
      "description": "Final distance estimate after clamping/combination. Unclamped numerical DE and gradient norm are emitted in calcde_gradient.",
      "pre_render": false,
      "fields": [
        {
          "name": "bufRout",
          "type": "double12"
        },
        {
          "name": "final_de",
          "type": "double12"
        },
        {
          "name": "ItResultI",
          "type": "int"
        },
        {
          "name": "DEoptionResult",
          "type": "int"
        }
      ]
    },
    "normals_raw": {
      "description": "Surface normals computed from DE gradient, before any smoothing. Pascal stores these as integers in PsiLight5.NormalX/Y/Z; C++ mirrors that storage.",
      "pre_render": false,
      "fields": [
        {
          "name": "nx",
          "type": "int"
        },
        {
          "name": "ny",
          "type": "int"
        },
        {
          "name": "nz",
          "type": "int"
        }
      ]
    },
